// ─────────────────────────────────────────────────────────────────────────────
// TokIO backtest check for TradingView — paste below your strategy's code.
// https://github.com/jordanahern2009-svg/Tokio-ai   (MIT licence)
//
// Is this strategy's profit distinguishable from luck? Reads the strategy's
// closed trades and draws a table on the chart with:
//   • a one-sided test of the mean trade return that allows for serial
//     dependence (Bartlett HAC, Andrews bandwidth, Kiefer-Vogelsang fixed-b),
//     the same test as TokIO's Python check_backtest on a trade list
//   • Sidak's correction for the number of variants you tried ("Trials")
//   • the Probabilistic / Deflated Sharpe Ratio (Bailey & Lopez de Prado),
//     as published and with the dependence correction
//   • the minimum track record length, and a symmetric-trim check
//
// A trade's return is its P&L as a % of the position's value
// (strategy.closedtrades.profit_percent), so position sizing doesn't move
// the verdict. The Python package does more — several variants corrected
// for each other, probability of backtest overfitting, costs/breakeven, the
// lookahead (one-bar delay) check — on the Strategy Tester's trade export:
//     pip install tokio-ai
//     tokio-ai-backtest "List of trades.csv" --trials 30
//
// Requires: //@version=6 and a strategy() script. Rename nothing below.
// ─────────────────────────────────────────────────────────────────────────────

tokio_trials = input.int(1, "Variants tried (incl. this one)", minval = 1, group = "TokIO check",
     tooltip = "Every parameter set, indicator or rule you tried before keeping this one. Be honest: the correction is only as good as this number.")
tokio_alpha = input.float(0.05, "Significance level", minval = 0.001, maxval = 0.5, group = "TokIO check")
tokio_pos = input.string("bottom_right", "Table position", options = ["top_right", "bottom_right", "bottom_left", "top_left"], group = "TokIO check")

// Standard normal CDF (Abramowitz & Stegun 7.1.26 erf, |error| < 1.5e-7)
tokio_cdf(float z) =>
    x = math.abs(z) / math.sqrt(2.0)
    t = 1.0 / (1.0 + 0.3275911 * x)
    y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * math.exp(-x * x)
    z >= 0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y)

// Inverse standard normal CDF (Acklam, relative error < 1.2e-9)
tokio_inv(float p) =>
    a1 = -3.969683028665376e+01
    a2 = 2.209460984245205e+02
    a3 = -2.759285104469687e+02
    a4 = 1.383577518672690e+02
    a5 = -3.066479806614716e+01
    a6 = 2.506628277459239e+00
    b1 = -5.447609879822406e+01
    b2 = 1.615858368580409e+02
    b3 = -1.556989798598866e+02
    b4 = 6.680131188771972e+01
    b5 = -1.328068155288572e+01
    c1 = -7.784894002430293e-03
    c2 = -3.223964580411365e-01
    c3 = -2.400758277161838e+00
    c4 = -2.549732539343734e+00
    c5 = 4.374664141464968e+00
    c6 = 2.938163982698783e+00
    d1 = 7.784695709041462e-03
    d2 = 3.224671290700398e-01
    d3 = 2.445134137142996e+00
    d4 = 3.754408661907416e+00
    float r = na
    if p < 0.02425
        q = math.sqrt(-2.0 * math.log(p))
        r := (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6) / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
    else if p <= 1.0 - 0.02425
        q = p - 0.5
        s = q * q
        r := (((((a1 * s + a2) * s + a3) * s + a4) * s + a5) * s + a6) * q / (((((b1 * s + b2) * s + b3) * s + b4) * s + b5) * s + 1.0)
    else
        q = math.sqrt(-2.0 * math.log(1.0 - p))
        r := -(((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6) / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1.0)
    r

tokio_fmt(float v, int dp) =>
    na(v) ? "–" : str.tostring(v, dp == 2 ? "#,##0.00" : dp == 3 ? "0.000" : "0.0000")

if barstate.islastconfirmedhistory or (barstate.islast and barstate.isrealtime)
    int n = strategy.closedtrades
    var table tbl = na
    if not na(tbl)
        table.delete(tbl)
    pos = tokio_pos == "top_right" ? position.top_right : tokio_pos == "bottom_left" ? position.bottom_left : tokio_pos == "top_left" ? position.top_left : position.bottom_right
    tbl := table.new(pos, 2, 12, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1, frame_color = color.gray, frame_width = 1)
    txt = color.white
    table.cell(tbl, 0, 0, "TokIO check", text_color = txt, text_size = size.small)
    if n < 60
        table.cell(tbl, 1, 0, "NOT REPORTABLE", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 0, 1, "Closed trades", text_color = txt, text_size = size.small)
        table.cell(tbl, 1, 1, str.tostring(n) + " (need 60+)", text_color = txt, text_size = size.small)
    else
        rets = array.new_float(0)
        for i = 0 to n - 1
            array.push(rets, strategy.closedtrades.profit_percent(i) / 100.0)
        float m = array.avg(rets)
        // central moments (population), Bartlett long-run variance
        float s2 = 0.0
        float s3 = 0.0
        float s4 = 0.0
        float g1 = 0.0
        for i = 0 to n - 1
            d = array.get(rets, i) - m
            s2 += d * d
            s3 += d * d * d
            s4 += d * d * d * d
            if i > 0
                g1 += d * (array.get(rets, i - 1) - m)
        v = s2 / n
        sd = math.sqrt(s2 / (n - 1))
        skew = (s3 / n) / math.pow(v, 1.5)
        kurt = (s4 / n) / (v * v)
        // Andrews (1991) AR(1) plug-in and the Newey-West rule; the larger wins
        rho = math.max(-0.97, math.min(0.97, g1 / s2))
        a1 = 4.0 * rho * rho / (math.pow(1.0 - rho, 2) * math.pow(1.0 + rho, 2))
        int L = math.min(n - 1, math.max(int(math.floor(4.0 * math.pow(n / 100.0, 2.0 / 9.0))), int(1.1447 * math.pow(a1 * n, 1.0 / 3.0))))
        float lrv = s2
        if L > 0
            for l = 1 to L
                float gl = 0.0
                for t = l to n - 1
                    gl += (array.get(rets, t) - m) * (array.get(rets, t - l) - m)
                lrv += 2.0 * (1.0 - l / (L + 1.0)) * gl
        lrv := math.max(lrv / n, 1e-18)
        b = (L + 1.0) / n
        fb = 1.6449 / (1.6449 + 2.1859 * b + 0.3142 * b * b - 0.3427 * b * b * b)
        z = m / math.sqrt(lrv / n) * fb
        p_alone = 1.0 - tokio_cdf(z)
        p_adj = 1.0 - math.pow(1.0 - p_alone, tokio_trials)
        z_naive = m / (sd / math.sqrt(n))
        p_naive = 1.0 - tokio_cdf(z_naive)
        // Sharpe per trade; annualized by trades per year
        sr = m / sd
        span_years = (strategy.closedtrades.exit_time(n - 1) - strategy.closedtrades.entry_time(0)) / (365.25 * 86400000.0)
        tpy = span_years > 0 ? n / span_years : na
        sr_ann = na(tpy) ? na : sr * math.sqrt(tpy)
        // PSR / DSR (Bailey & Lopez de Prado); vr scales Var(SR) for dependence
        vr = (lrv / v) / (fb * fb)
        core = math.max(1.0 - skew * sr + (kurt - 1.0) / 4.0 * sr * sr, 1e-12)
        gam = 0.5772156649015329
        bench = tokio_trials > 1 ? math.sqrt(1.0 / (n - 1)) * ((1.0 - gam) * tokio_inv(1.0 - 1.0 / tokio_trials) + gam * tokio_inv(1.0 - 1.0 / (tokio_trials * math.e))) : 0.0
        psr_pub = tokio_cdf((sr - bench) * math.sqrt(n - 1) / math.sqrt(core))
        psr_dep = tokio_cdf((sr - bench) * math.sqrt(n - 1) / math.sqrt(core * vr))
        mintrl = sr > bench ? 1.0 + core * vr * math.pow(tokio_inv(0.95) / (sr - bench), 2) : na
        // symmetric trim: drop the 5 best and 5 worst trades
        sorted = array.copy(rets)
        array.sort(sorted, order.ascending)
        k = math.min(5, int(n / 20))
        tr = array.slice(sorted, k, n - k)
        sr_trim = array.stdev(tr, false) > 0 ? array.avg(tr) / array.stdev(tr, false) * (na(tpy) ? 1.0 : math.sqrt(tpy)) : na
        sig = p_adj <= tokio_alpha
        verdict = sig ? "SIGNIFICANT" : "NOT SIGNIFICANT"
        table.cell(tbl, 1, 0, verdict + (tokio_trials > 1 ? " (" + str.tostring(tokio_trials) + " trials)" : ""), text_color = sig ? color.lime : color.red, text_size = size.small)
        rows = array.from("p-value, corrected", "p-value, this alone", "p-value, plain t-test", "Sharpe (annualized)", (tokio_trials > 1 ? "Deflated" : "Probabilistic") + " Sharpe Ratio", "  as published (indep. trades)", "Min. track record (trades)", "Sharpe w/o 5 best & 5 worst", "Closed trades", "Trades per year")
        vals = array.from(tokio_fmt(p_adj, 4), tokio_fmt(p_alone, 4), tokio_fmt(p_naive, 4), tokio_fmt(sr_ann, 2), tokio_fmt(psr_dep, 3) + "  (0.95 passes)", tokio_fmt(psr_pub, 3), na(mintrl) ? "never" : str.tostring(math.ceil(mintrl)), tokio_fmt(sr_trim, 2), str.tostring(n), tokio_fmt(tpy, 2))
        for i = 0 to array.size(rows) - 1
            table.cell(tbl, 0, i + 1, array.get(rows, i), text_color = txt, text_size = size.small, text_halign = text.align_left)
            table.cell(tbl, 1, i + 1, array.get(vals, i), text_color = txt, text_size = size.small, text_halign = text.align_right)
        table.cell(tbl, 0, 11, "Mean trade return " + tokio_fmt(m * 100.0, 3) + "%; HAC lag window " + str.tostring(L), text_color = color.gray, text_size = size.tiny, text_halign = text.align_left)
        table.merge_cells(tbl, 0, 11, 1, 11)
